# Shell scripts must keep LF endings on every platform so the curl
# installer runs as-is. Do not cover these with .gitignore rules.
# linguist-vendored keeps the one installer script out of the repo's
# language stats (it would otherwise show as Shell 0.1%).
*.sh text eol=lf linguist-vendored
*.bat text eol=crlf linguist-vendored
*.ps1 text eol=crlf linguist-vendored
windows-release/*.exe binary linguist-vendored
linux-release/* binary linguist-vendored
macos-release/* binary linguist-vendored
