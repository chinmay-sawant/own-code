# Binaries and build output
/own-code
/own-code.exe
*.exe
*.test
*.out
/dist/
/bin/

# Dependencies resolve through the module proxy. vendor/ stays local-only
# and is never committed.
/vendor/

# Go cache and coverage
*.coverprofile
coverage.txt

# Screenshots taken by the test suite land outside the repo.
# See README: OWNFRAME_CODE_VIEW_SCREENSHOT=1 writes to /tmp/opencode/code-view-shots/.
/tmp/

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# User session files are written to the OS config dir, not here.
# Kept here so a stray local session file never gets committed.
session-*.json

# Local environment files containing API keys and secrets
.env
.env.local
.env.*
!.env.example

# Generated merge-conflict demo repo (testdata/merge-conflicts/setup.sh).
# It holds a nested .git dir mid-merge and is rebuilt on demand.
/testdata/merge-conflicts/demo/
